     return res;
 }
+
+std::optional<uintptr_t> Elf::FileOffsetForAddress(uintptr_t address) const {
+    if (address < bias_addr_) return std::nullopt;
+    const uintptr_t virtual_address = address - bias_addr_;
+    auto ph_off = reinterpret_cast<uintptr_t>(program_header_);
+    for (int i = 0; i < header_->e_phnum; ++i, ph_off += header_->e_phentsize) {
+        const auto *program_header = reinterpret_cast<const ElfW(Phdr) *>(ph_off);
+        if (program_header->p_type != PT_LOAD) continue;
+        if (virtual_address < program_header->p_vaddr ||
+            virtual_address >= program_header->p_vaddr + program_header->p_memsz) {
+            continue;
+        }
+        return program_header->p_offset + virtual_address - program_header->p_vaddr;
+    }
+    return std::nullopt;
+}
